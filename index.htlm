<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jemal Mobile Services</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-900 text-gray-100 font-sans">

    <!-- Header / Navbar -->
    <header class="bg-slate-800/80 backdrop-blur-md border-b border-slate-700 sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold text-blue-500">Jemal Mobile</h1>
                <div id="shop-status" class="mt-1"></div>
            </div>
            <a href="https://t.me/" target="_blank" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2">
                <i class="fab fa-telegram"></i> ቴሌግራማችን
            </a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="max-w-6xl mx-auto px-4 py-16 text-center">
        <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-4">
            የስልክ ጥገና እና የሶፍትዌር አገልግሎት
        </h2>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto mb-8">
            የተለያዩ የስልክ ሶፍትዌር እና ሃርድዌር ችግሮችን በፍጥነት እና በጥራት እንፈታለን።
        </p>
        <a href="#calculator" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-medium inline-block">
            የጥገና ዋጋ ለመገመት
        </a>
    </section>

    <!-- Services Section -->
    <section id="services" class="max-w-6xl mx-auto px-4 py-12">
        <h3 class="text-2xl font-bold text-center text-white mb-10">የምንሰጣቸው አገልግሎቶች</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700 hover:border-blue-500 transition">
                <div class="text-blue-500 text-3xl mb-4"><i class="fas fa-code"></i></div>
                <h4 class="text-xl font-bold mb-2">የሶፍትዌር እድሳት</h4>
                <p class="text-gray-400 text-sm">Flashing, FRP Bypass, iOS/Android ስርዓት ማስተካከል እና አፕሊኬሽኖችን መጫን።</p>
            </div>

            <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700 hover:border-blue-500 transition">
                <div class="text-blue-500 text-3xl mb-4"><i class="fas fa-screwdriver-wrench"></i></div>
                <h4 class="text-xl font-bold mb-2">የሃርድዌር ጥገና</h4>
                <p class="text-gray-400 text-sm">ስክሪን መቀየር፣ የቻርጀር ፖርት ጥገና፣ ባትሪ መቀየር እና የቦርድ ጥገና።</p>
            </div>

            <div class="bg-slate-800 p-6 rounded-2xl border border-slate-700 hover:border-blue-500 transition">
                <div class="text-blue-500 text-3xl mb-4"><i class="fas fa-mobile-screen-button"></i></div>
                <h4 class="text-xl font-bold mb-2">የስልክ እቃዎች</h4>
                <p class="text-gray-400 text-sm">ጥራት ያላቸው ቻርጀሮች፣ ገመዶች፣ ስክሪን ፕሮቴክተሮች እና ተጨማሪ እቃዎች።</p>
            </div>

        </div>
    </section>

    <!-- Calculator Section -->
    <section id="calculator" class="max-w-2xl mx-auto px-4 py-12">
        <div class="bg-slate-800 p-8 rounded-2xl border border-slate-700 text-center">
            <h3 class="text-2xl font-bold text-white mb-4">የጥገና ዋጋ ግምት ማሰሪያ</h3>
            <p class="text-gray-400 text-sm mb-6">የሚፈልጉትን የጥገና ዓይነት መርጠው ግምታዊ ዋጋቸውን ይመልከቱ፦</p>
            
            <select id="service-type" onchange="calculateCost()" class="w-full bg-slate-900 border border-slate-700 text-white p-3 rounded-xl mb-4 focus:outline-none focus:border-blue-500">
                <option value="0">-- የጥገና ዓይነት ይምረጡ --</option>
                <option value="300 - 500">የሶፍትዌር ጭነት / Flashing</option>
                <option value="400 - 800">FRP / አካውንት መክፈት</option>
                <option value="200 - 400">የቻርጀር ፖርት (Charging Port)</option>
                <option value="500 - 1500">የስክሪን ቅይጣ (Screen Replacement)</option>
                <option value="400 - 900">የባትሪ ቅይጣ (Battery Replacement)</option>
            </select>

            <div id="estimated-cost" class="text-gray-400 text-sm mt-2"></div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="max-w-6xl mx-auto px-4 py-16 text-center border-t border-slate-800">
        <h3 class="text-2xl font-bold text-white mb-4">አሁኑኑ ያናግሩን</h3>
        <p class="text-gray-400 mb-6">ለማንኛውም አይነት የስልክ ጥገና ጥያቄ ይደውሉልን ወይም በአካል ይጎብኙን።</p>
        <div class="flex justify-center gap-4">
            <a href="tel:+251900000000" class="bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-xl font-semibold transition flex items-center gap-2">
                <i class="fas fa-phone"></i> ስልክ ለመደወል
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-950 text-gray-500 text-center py-6 border-t border-slate-800 text-sm">
        <p>© 2026 Jemal Mobile Services. All rights reserved.</p>
    </footer>

    <!-- JS Link -->
    <script src="app.js"></script>
</body>
</html>
